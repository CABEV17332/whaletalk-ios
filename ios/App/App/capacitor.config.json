	"webDir": "web",
	"bundledWebRuntime": false,
	"server": {
		"url": "https://chat.example.com",
		"cleartext": false,
		"androidScheme": "https",
		"iosScheme": "capacitor",
		"allowNavigation": []
	},
	"ios": {
		"contentInset": "never",
		"scrollEnabled": false,
		"limitsNavigationsToAppBoundDomains": false,
